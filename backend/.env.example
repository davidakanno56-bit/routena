# Routena Backend Configuration

# --- Google Cloud / Maps Platform ---
# 1. Go to https://console.cloud.google.com/
# 2. Enable "Routes API" (routes.googleapis.com)
# 3. Create an API key in APIs & Services > Credentials
ROUTENA_GOOGLE_ROUTES_API_KEY=
ROUTENA_ROUTING_PROVIDER=google

# Fallback without API key: change to "osrm" to route for free using OpenStreetMap
# ROUTENA_ROUTING_PROVIDER=osrm

# --- Database & Environment ---
ROUTENA_DATABASE_URL=sqlite:///./routena.db
ROUTENA_DEMO_MODE=true
ROUTENA_DRIVER_ONBOARDING_DEMO=true
ROUTENA_DISPATCH_DEMO=true
ROUTENA_ADMIN_TOKEN=demo-admin-token-2026
ROUTENA_PILOT_CITY=Calabar
